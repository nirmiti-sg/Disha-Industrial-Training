    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/layoutstyle"
        android:orientation="horizontal"
        android:onClick="openCustomer"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="2dp">
        <ImageButton
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="20dp"
            android:scaleType="fitCenter"
            android:id="@+id/customerimg"
            android:src="@mipmap/customer"
            ></ImageButton>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28dp"
            android:layout_marginTop="55dp"
            android:layout_marginLeft="30dp"
            android:textColor="#000000"
            android:paddingRight="22dp"
            android:text="customer"
            android:fontFamily="serif"
            android:id="@+id/customertext"
            android:textStyle="bold"></TextView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/layoutstyle"
        android:orientation="horizontal"
        android:onClick="openDriver"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="2dp">
        <ImageButton
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="20dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/driver"
            android:id="@+id/drierimg"
            ></ImageButton>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28dp"
            android:text="Driver"
            android:layout_marginTop="55dp"
            android:layout_marginLeft="30dp"
            android:textColor="#000000"
            android:paddingRight="62dp"
            android:fontFamily="serif"
            android:id="@+id/driertext"
            android:textStyle="bold"></TextView>
    </LinearLayout>

</LinearLayout>