<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/logo"
        android:id="@+id/img6" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="30dp"
        android:text="Customer"
        android:textSize="30sp"
        android:textColor="#000000"
        android:textStyle="bold"
        android:id="@+id/driver5" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Entyer party name"
        android:textSize="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="40dp"
        android:textColor="#000000"
        android:id="@+id/customerinput5"/>
    <EditText
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:background="@drawable/edittext"
        android:inputType="text"
        android:layout_marginLeft="40dp"
        android:id="@+id/custinputpname"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="party address"
        android:textSize="20dp"
        android:layout_marginTop="5dp"
        android:textColor="#000000"
        android:layout_marginLeft="40dp"
        android:id="@+id/customerinput7"/>
    <EditText
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:background="@drawable/edittext"
        android:inputType="text"
        android:layout_marginLeft="40dp"
        android:id="@+id/custinputpaddress"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="contact person name"
        android:textSize="20dp"
        android:textColor="#000000"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="40dp"
        android:id="@+id/customerinput9"/>
    <EditText
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:background="@drawable/edittext"
        android:inputType="text"
        android:layout_marginLeft="40dp"
        android:id="@+id/custinputcname"/>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="phone no"
        android:textSize="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="40dp"
        android:textColor="#000000"
        android:id="@+id/customerinput11"/>
    <EditText
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:background="@drawable/edittext"
        android:inputType="number"
        android:digits="0123456789"
        android:maxLength="10"
        android:layout_marginLeft="40dp"
        android:id="@+id/custinputphoneno"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="pan no"
        android:textSize="20dp"
        android:layout_marginTop="5dp"
        android:textColor="#000000"
        android:layout_marginLeft="40dp"
        android:id="@+id/customerinput13"/>
    <EditText
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:background="@drawable/edittext"
        android:inputType="text"
        android:layout_marginLeft="40dp"
        android:id="@+id/custinputpanno"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GST no"
        android:textSize="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="40dp"
        android:textColor="#000000"
        android:id="@+id/customerinput15"/>
    <EditText
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:background="@drawable/edittext"
        android:inputType="text"
        android:layout_marginLeft="40dp"
        android:id="@+id/custinputgstno"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password:"
            android:textSize="20dp"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="40dp"
            android:textColor="#000000"
            android:id="@+id/customerinput16"/>
        <EditText
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:background="@drawable/edittext"
            android:inputType="text"
            android:layout_marginLeft="40dp"
            android:id="@+id/custinputpass"/>

        <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign up"
        android:padding="10dp"
        android:textSize="25dp"
        android:background="@drawable/buttons"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:textColor="#ffffff"
        android:id="@+id/btncustsignup"/>
</LinearLayout>
</ScrollView>

</LinearLayout>