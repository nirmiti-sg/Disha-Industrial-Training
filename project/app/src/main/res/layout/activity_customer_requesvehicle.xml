<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/logo"
        android:id="@+id/img6" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="20dp"
        android:text="Request vehicle:"
        android:textSize="30sp"
        android:textColor="#000000"
        android:textStyle="bold"
        android:id="@+id/rv" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="select vehicle type"
        android:textSize="25dp"
        android:layout_marginTop="10dp"
        android:textColor="#000000"
        android:layout_marginLeft="30dp"
        android:id="@+id/crequesttext1"
        />
        <Spinner
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:textSize="20dp"
            android:gravity="center"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="40dp"
            android:background="@drawable/layoutstyle"
            android:textColor="#000000"
            android:id="@+id/dropdown1"></Spinner>
 <!--   <TextView
        android:layout_width="370dp"
        android:layout_height="55dp"
        android:text="(dropdown)"
        android:textSize="20dp"
        android:gravity="center"
        android:background="@drawable/layoutstyle"
        android:layout_marginLeft="40dp"
        android:textColor="#000000"
        android:id="@+id/dropdown1"
        />
-->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Consignor(source)"
        android:textSize="25dp"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="30dp"
        android:textColor="#000000"
        android:id="@+id/crequesttext2"
        />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:textSize="20dp"
            android:gravity="center"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="40dp"
            android:background="@drawable/layoutstyle"
            android:textColor="#000000"
            android:id="@+id/etsourceaddress"></EditText>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="select consignee(destination)"
        android:textSize="25dp"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="30dp"
        android:textColor="#000000"
        android:id="@+id/crequesttext3"
        />

        <Spinner
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:textSize="20dp"
            android:gravity="center"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="40dp"
            android:background="@drawable/layoutstyle"

            android:id="@+id/dropdown3"></Spinner>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Custom Billing party*"
        android:textSize="25dp"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="30dp"
        android:textColor="#000000"
        android:id="@+id/crequesttext5"
        />
    <EditText
        android:layout_width="370dp"
        android:layout_height="50dp"
        android:background="@drawable/edittext"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="40dp"
        android:id="@+id/billingp"
        />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quentity*"
        android:textSize="25dp"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="30dp"
        android:id="@+id/crequesttext6"
        android:textColor="#000000"/>
    <EditText
        android:layout_width="170dp"
        android:layout_height="50dp"
        android:background="@drawable/edittext"
        android:layout_marginLeft="30dp"
        android:id="@+id/cquantity"
        />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weight*"
            android:textSize="25dp"
            android:layout_marginTop="15dp"
            android:layout_marginLeft="30dp"
            android:textColor="#000000"
            android:id="@+id/crequesttext7"
            />
        <EditText
            android:layout_width="170dp"
            android:layout_height="50dp"
            android:background="@drawable/edittext"
            android:layout_marginLeft="30dp"
            android:id="@+id/cweight"
            />
    </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date*"
                android:textSize="25dp"
                android:layout_marginTop="15dp"
                android:layout_marginLeft="30dp"
                android:textColor="#000000"
                android:id="@+id/crequesttext8"
                />
            <EditText
                android:layout_width="170dp"
                android:layout_height="50dp"
                android:background="@drawable/edittext"
                android:hint="DD/MM/YYYY"
                android:layout_marginLeft="30dp"
                android:id="@+id/cdate"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time*"
                android:textSize="25dp"
                android:layout_marginTop="15dp"
                android:layout_marginLeft="30dp"
                android:id="@+id/crequesttext9"
                android:textColor="#000000"
                />
            <EditText
                android:layout_width="170dp"
                android:layout_height="50dp"
                android:background="@drawable/edittext"
                android:hint="HH:MM"
                android:layout_marginLeft="30dp"
                android:id="@+id/ctime"
                />
        </LinearLayout>

    </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PO NO."
                android:textSize="25dp"
                android:layout_marginTop="15dp"
                android:layout_marginLeft="30dp"
                android:id="@+id/crequesttext10"
                android:textColor="#000000"
                />
            <EditText
                android:layout_width="170dp"
                android:layout_height="50dp"
                android:background="@drawable/edittext"
                android:layout_marginLeft="30dp"
                android:id="@+id/cpono"
                />
        </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Part no."
                    android:textSize="25dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginLeft="30dp"
                    android:id="@+id/crequesttext11"
                    android:textColor="#000000"
                    />
                <EditText
                    android:layout_width="170dp"
                    android:layout_height="50dp"
                    android:background="@drawable/edittext"
                    android:layout_marginLeft="30dp"
                    android:id="@+id/cpartno"
                    />
            </LinearLayout>


        </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center">
   <Button
       android:layout_width="120dp"
       android:layout_height="60dp"
       android:text="send"
       android:background="@drawable/buttons"
       android:textSize="30dp"
      android:gravity="center"
       android:textColor="#ffffff"
       android:id="@+id/sendreq"
       android:layout_marginTop="30dp"
       />

        <Button
            android:id="@+id/canclereq"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/buttons"
            android:gravity="center"
            android:onClick="opencustomerhomepage"
            android:text="cancle"
            android:textColor="#ffffff"
            android:textSize="30dp" />
    </LinearLayout>

    </LinearLayout>
    </ScrollView>
</LinearLayout>